# MediLingua Frontend Environment Variables
# Copy this file to .env.local to configure custom environments

# Backend API endpoint URL (leave empty in production to use relative /api proxy)
VITE_API_BASE_URL=

# Application Display Name
VITE_APP_NAME="MediLingua Telemedicine"

# Feature toggles
VITE_ENABLE_AI_TRANSLATION=true
VITE_ENABLE_AUDIO_SYNTHESIS=true
